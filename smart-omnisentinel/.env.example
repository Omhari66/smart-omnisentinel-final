# ============================================================
# SmartOmniSentinel — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.
# ============================================================

# --- Application ---
APP_ENV=development            # development | production
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Database ---
DB__URL=postgresql+asyncpg://sentinel:sentinel_pass@localhost:5432/sentinel
DB__POOL_SIZE=10
DB__MAX_OVERFLOW=20

# --- Redis (set REDIS__ENABLED=false to use in-process asyncio.Queue) ---
REDIS__URL=redis://localhost:6379/0
REDIS__ENABLED=false

# --- Inference ---
INFERENCE__DEVICE=cpu                  # cpu | cuda
INFERENCE__DETECTOR_MODEL=ml/checkpoints/yolov8n.pt
INFERENCE__POSE_MODEL=ml/checkpoints/yolov8n-pose.pt
INFERENCE__CLASSIFIER_CHECKPOINT=ml/checkpoints/temporal_v1.pt
INFERENCE__EFFECTIVE_FPS=4
INFERENCE__DETECTION_SKIP_FRAMES=4
INFERENCE__PERSISTENCE_FRAMES=12
INFERENCE__EMA_ALPHA=0.35
INFERENCE__USE_TENSORRT=false

# --- Storage ---
STORAGE__EVIDENCE_ROOT=evidence_storage
STORAGE__MAX_DISK_GB=50.0
STORAGE__STAGING_TTL_HOURS=2

# --- Notifications ---
NOTIFICATIONS__SMTP_HOST=smtp.gmail.com
NOTIFICATIONS__SMTP_PORT=587
NOTIFICATIONS__SMTP_USER=alerts@yoursite.com
NOTIFICATIONS__SMTP_PASSWORD=your-app-password
NOTIFICATIONS__SMTP_FROM=SmartOmniSentinel <alerts@yoursite.com>
NOTIFICATIONS__ALERT_RECIPIENTS=security@yoursite.com,supervisor@yoursite.com
NOTIFICATIONS__WEBHOOK_URLS=[]
NOTIFICATIONS__TWILIO_ENABLED=false
NOTIFICATIONS__TWILIO_ACCOUNT_SID=
NOTIFICATIONS__TWILIO_AUTH_TOKEN=
NOTIFICATIONS__TWILIO_FROM_NUMBER=
NOTIFICATIONS__TWILIO_TO_NUMBERS=[]

# --- JWT ---
JWT__ALGORITHM=HS256
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT__REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Evidence Signed URLs ---
SIGNED_URL__SECRET=another-secret-for-signed-urls
SIGNED_URL__EXPIRY_SECONDS=900

# --- Observability ---
# Sentry error tracking. Leave empty to disable (no data sent to Sentry).
# Get your DSN from: https://sentry.io -> Project -> Settings -> Client Keys
OBSERVABILITY__SENTRY_DSN=
OBSERVABILITY__SENTRY_TRACES_SAMPLE_RATE=0.1
OBSERVABILITY__SENTRY_PROFILES_SAMPLE_RATE=0.1
# Prometheus /metrics endpoint (nginx blocks public access, internal only)
OBSERVABILITY__PROMETHEUS_ENABLED=true
